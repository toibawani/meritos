{
  "name": "meritos",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "merit-cli": "./bin/merit-cli.mjs"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "pretest": "node scripts/build-test-lib.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=.test-build/crypto.js --test-coverage-include=.test-build/zkProof.js tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
