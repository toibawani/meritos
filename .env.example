# ─────────────────────────────────────────────────────────────
#  MeritOS environment configuration
#
#  This application requires NO environment variables to run.
#  All cryptography (Ed25519, SHA-256, Merkle trees) executes
#  client-side via the native WebCrypto API. There is no database
#  and no backend — identity and credentials are generated and
#  verified entirely in the browser.
#
#  The variables below are OPTIONAL. They only enrich the values
#  returned by the /api/health route for observability / uptime
#  checks. Omit them and sensible defaults are used.
# ─────────────────────────────────────────────────────────────

# Git commit SHA surfaced by GET /api/health (falls back to "unknown").
COMMIT_SHA=

# Semantic version surfaced by GET /api/health (falls back to package.json version).
APP_VERSION=
